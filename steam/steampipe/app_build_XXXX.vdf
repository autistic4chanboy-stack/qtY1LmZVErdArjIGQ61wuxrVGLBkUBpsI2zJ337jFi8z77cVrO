// SteamPipe : la construction de l'application (tous les dépôts).
// À remplacer : APPID (identifiant de l'application) et les DEPOTID_* (un dépôt par système),
// le plus simple : node ../scripts/set-ids.js --app <id> --win <id> --linux <id> [--mac <id>]
// Envoi : ./upload.sh <compte Steamworks>   (voir ../CHECKLIST.md)
"AppBuild"
{
	"AppID"	"APPID"
	"Desc"	"Newy and the Dark Forest 1.0.0"
	"BuildOutput"	"output/"
	"ContentRoot"	"../dist/"
	// "SetLive"	"beta"	// mise en ligne directe sur une branche (jamais "default" ici : à la main dans Steamworks)
	"Preview"	"0"
	"Depots"
	{
		"DEPOTID_WIN"	"depot_build_windows.vdf"
		"DEPOTID_LINUX"	"depot_build_linux.vdf"
		"DEPOTID_MAC"	"depot_build_macos.vdf"
	}
}
